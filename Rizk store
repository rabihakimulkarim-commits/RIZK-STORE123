<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Claud Phone</title>
    <style>
        * {margin:0; padding:0; box-sizing:border-box; font-family:Arial, sans-serif;}
        body {background: #000; min-height:100vh; color:#fff;}

        /* === HALAMAN LOGIN === */
        #authPage {display:flex; align-items:center; justify-content:center; min-height:100vh; padding:20px;}
        .auth-box {background:#1f1f3a; border-radius:16px; padding:30px; width:100%; max-width:400px; border:1px solid #9d4edd;}
        
        .tab-buttons {display:flex; margin-bottom:25px;}
        .tab-btn {flex:1; padding:10px; background:transparent; border:none; color:#888; font-size:16px; cursor:pointer; border-bottom:2px solid transparent;}
        .tab-btn.active {color:#9d4edd; border-bottom-color:#9d4edd;}

        .tab-content {display:none;}
        .tab-content.active {display:block;}

        h2 {text-align:center; margin-bottom:20px; color:#fff;}
        
        .input-wrap {margin-bottom:15px; position:relative;}
        input {width:100%; padding:14px 45px 14px 15px; background:#2a2a4a; border:1px solid #444; border-radius:8px; color:#fff; font-size:15px; outline:none;}
        input:focus {border-color:#9d4edd;}
        
        .eye-icon {position:absolute; right:12px; top:50%; transform:translateY(-50%); background:none; border:none; color:#aaa; font-size:18px; cursor:pointer;}
        
        button[type="submit"] {width:100%; padding:14px; background:linear-gradient(90deg, #7b2cbf, #9d4edd); color:#fff; border:none; border-radius:8px; font-size:16px; font-weight:bold; cursor:pointer;}
        
        .msg {margin-top:12px; text-align:center; font-size:14px; min-height:20px;}
        .error {color:#f87171;}
        .success {color:#4ade80;}

        /* === HALAMAN UTAMA === */
        #mainPage {display:none; min-height:100vh; padding-bottom:90px;}
        .navbar {background:#1f1f3a; padding:15px 20px; display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid #9d4edd; position:sticky; top:0;}
        .navbar h1 {font-size:18px; color:#9d4edd;}
        .logout-btn {background:#ef4444; border:none; padding:8px 15px; color:#fff; border-radius:6px; cursor:pointer;}

        /* Tulisan Permanen Claud Phone */
        .brand-permanen {
            background:#1f1f3a;
            text-align:center;
            padding:10px 20px;
            border-bottom:1px solid #9d4edd;
        }
        .brand-permanen h2 {
            margin:0;
            font-size:22px;
            color:#9d4edd;
            font-weight:bold;
        }

        .page {display:none; padding:20px;}
        .page.active {display:block;}

        /* Toko */
        .shop-container {max-width:420px; margin:0 auto; padding-top:20px;}
        .shop-item {background:#121226; color:#fff; border:1px solid #9d4edd; border-radius:16px; padding:25px; text-align:center; margin-bottom:20px;}
        .shop-item h3 {font-size:20px; margin-bottom:8px;}
        .shop-item p {color:#aaa; font-size:15px; margin-bottom:15px;}
        
        .price {color:#4ade80; font-size:28px; font-weight:bold; margin:15px 0;}
        .buy-btn {background:#25d366; border:none; padding:14px 30px; color:#fff; border-radius:8px; font-size:17px; font-weight:bold; cursor:pointer; width:100%;}
        .buy-btn:hover {background:#128c7e;}

        /* Layar Info Pembelian */
        #infoPage {display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:#000; z-index:9999; flex-direction:column; align-items:center; justify-content:center; padding:30px; text-align:center;}
        #infoPage h2 {font-size:22px; margin-bottom:30px; color:#fff;}
        .info-text {font-size:18px; line-height:2; margin-bottom:30px; color:#ddd; max-width:100%; word-break:break-word;}
        
        /* Link yang Bisa Diklik */
        .info-link {
            display:inline-block;
            color:#25d366;
            font-size:15px;
            padding:8px 12px;
            border:1px solid #25d366;
            border-radius:6px;
            text-decoration:none;
            margin-top:10px;
            cursor:pointer;
        }
        .info-link:hover {
            background:#25d366;
            color:#000;
        }
        
        .back-btn {background:transparent; border:2px solid #9d4edd; color:#9d4edd; padding:12px 40px; border-radius:8px; font-size:16px; font-weight:bold; cursor:pointer; margin-top:30px;}
        .back-btn:hover {background:#9d4edd; color:#fff;}

        /* Profil */
        .profile-card {background:#121226; border-radius:16px; padding:30px; text-align:center; max-width:360px; margin:30px auto; border:1px solid #9d4edd;}
        .profile-avatar {font-size:60px; margin-bottom:10px;}
        .profile-name {font-size:22px; color:#9d4edd; font-weight:bold; margin-bottom:10px;}
        .profile-info {color:#aaa; line-height:1.8;}

        /* Navigasi Bawah */
        .bottom-nav {position:fixed; bottom:0; left:0; right:0; background:#121226; display:flex; border-top:1px solid #9d4edd; padding:10px 0;}
        .nav-link {flex:1; padding:15px 12px; text-align:center; background:transparent; border:none; color:#888; font-size:16px; cursor:pointer;}
        .nav-link.active {color:#9d4edd; border-top:2px solid #9d4edd; padding-top:10px;}
        .nav-link span {display:block; font-size:12px; margin-top:2px;}
    </style>
</head>
<body>

    <!-- LAYAR INFO BELI -->
    <div id="infoPage">
        <h2>📦 Informasi Pembelian</h2>
        <div class="info-text">
            Beli di nomor ini:<br>
            <strong style="font-size:20px; color:#4ade80;">0823 7393 4167</strong><br><br>
            Atau klik link di bawah ini:<br>
            <a class="info-link" href="https://wa.me/6282373934167?text=Halo%20Mau%20beli" target="_blank" rel="noopener noreferrer">👉 Buka WhatsApp</a>
        </div>
        <button class="back-btn" onclick="tutupInfo()">❌ Keluar</button>
    </div>

    <!-- HALAMAN LOGIN & DAFTAR -->
    <div id="authPage">
        <div class="auth-box">
            <div class="tab-buttons">
                <button class="tab-btn active" onclick="switchTab('login')">Login</button>
                <button class="tab-btn" onclick="switchTab('daftar')">Daftar</button>
            </div>

            <!-- FORM LOGIN -->
            <div id="loginTab" class="tab-content active">
                <h2>🔐 Masuk Akun</h2>
                <form onsubmit="return doLogin(event)">
                    <div class="input-wrap">
                        <input type="text" id="loginUser" placeholder="Username" required>
                    </div>
                    <div class="input-wrap">
                        <input type="password" id="loginPass" placeholder="Password" required>
                        <button type="button" class="eye-icon" onclick="togglePass('loginPass', this)">👁️</button>
                    </div>
                    <button type="submit">Masuk</button>
                    <div id="loginMsg" class="msg"></div>
                </form>
            </div>

            <!-- FORM DAFTAR -->
            <div id="daftarTab" class="tab-content">
                <h2>✨ Buat Akun Baru</h2>
                <form onsubmit="return doDaftar(event)">
                    <div class="input-wrap">
                        <input type="text" id="daftarUser" placeholder="Username" required>
                    </div>
                    <div class="input-wrap">
                        <input type="password" id="daftarPass" placeholder="Password" required>
                        <button type="button" class="eye-icon" onclick="togglePass('daftarPass', this)">👁️</button>
                    </div>
                    <button type="submit">Daftar</button>
                    <div id="daftarMsg" class="msg"></div>
                </form>
            </div>
        </div>
    </div>

    <!-- HALAMAN UTAMA -->
    <div id="mainPage">
        <div class="navbar">
            <h1>Claud Phone</h1>
            <button class="logout-btn" onclick="logout()">Keluar</button>
        </div>

        <!-- Tulisan Permanen Claud Phone -->
        <div class="brand-permanen">
            <h2>Claud Phone</h2>
        </div>

        <!-- TOKO -->
        <div id="shopPage" class="page active">
            <h2 style="text-align:center; margin:25px 0; font-size:24px;">🛒 Toko</h2>
            <div class="shop-container">
                <div class="shop-item">
                    <h3>📱 Claud Phone</h3>
                    <p>Aplikasi Mod Terbaru</p>
                    <div class="price">Rp 5.000</div>
                    <button class="buy-btn" onclick="tampilkanInfo()">💬 Beli via WhatsApp</button>
                </div>

                <div class="shop-item">
                    <h3>☠️ Pembuat APK RAT</h3>
                    <p>Buat Kunci HP Orang</p>
                    <div class="price">Rp 3.000</div>
                    <button class="buy-btn" onclick="tampilkanInfo()">💬 Beli via WhatsApp</button>
                </div>
            </div>
        </div>

        <!-- PROFIL -->
        <div id="profilePage" class="page">
            <h2 style="text-align:center; margin:25px 0;">👤 Profil</h2>
            <div class="profile-card">
                <div class="profile-avatar">😎</div>
                <div class="profile-name" id="namaPengguna">-</div>
                <div class="profile-info">
                    <p>📧 Status: Anggota</p>
                    <p>📅 Bergabung: Hari Ini</p>
                </div>
            </div>
        </div>

        <!-- NAVIGASI BAWAH -->
        <div class="bottom-nav">
            <button class="nav-link active" onclick="bukaHalaman('shopPage', this)">
                🛒
                <span>Toko</span>
            </button>
            <button class="nav-link" onclick="bukaHalaman('profilePage', this)">
                👤
                <span>Profil</span>
            </button>
        </div>
    </div>

    <script>
        localStorage.removeItem('akunPengguna');

        function tampilkanInfo() {
            document.getElementById('infoPage').style.display = 'flex';
        }

        function tutupInfo() {
            document.getElementById('infoPage').style.display = 'none';
        }

        function switchTab(tab) {
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
            if (tab === 'login') {
                document.querySelectorAll('.tab-btn')[0].classList.add('active');
                document.getElementById('loginTab').classList.add('active');
            } else {
                document.querySelectorAll('.tab-btn')[1].classList.add('active');
                document.getElementById('daftarTab').classList.add('active');
            }
            clearAllMsg();
            return false;
        }

        function togglePass(id, btn) {
            const input = document.getElementById(id);
            if (input.type === 'password') {
                input.type = 'text';
                btn.textContent = '🙈';
            } else {
                input.type = 'password';
                btn.textContent = '👁️';
            }
        }

        function ambilDataAkun() {
            const data = localStorage.getItem('akunBaru');
            return data ? JSON.parse(data) : {};
        }

        function simpanDataAkun(data) {
            localStorage.setItem('akunBaru', JSON.stringify(data));
        }

        function doDaftar(e) {
            e.preventDefault();
            const user = document.getElementById('daftarUser').value.trim().toLowerCase();
            const pass = document.getElementById('daftarPass').value;
            const msg = document.getElementById('daftarMsg');
            const data = ambilDataAkun();

            if (!user || !pass) {
                msg.textContent = '❌ Isi semua kolom!';
                msg.className = 'msg error';
                return false;
            }

            if (data[user]) {
                msg.textContent = '❌ Username sudah dipakai!';
                msg.className = 'msg error';
                return false;
            }

            data[user] = pass;
            simpanDataAkun(data);
            
            msg.textContent = '✅ Berhasil daftar! Silakan login.';
            msg.className = 'msg success';
            
            setTimeout(() => switchTab('login'), 1500);
            document.getElementById('daftarUser').value = '';
            document.getElementById('daftarPass').value = '';
            return false;
        }

        function doLogin(e) {
            e.preventDefault();
            const user = document.getElementById('loginUser').value.trim().toLowerCase();
            const pass = document.getElementById('loginPass').value;
            const msg = document.getElementById('loginMsg');
            const data = ambilDataAkun();

            if (!user || !pass) {
                msg.textContent = '❌ Isi username & password!';
                msg.className = 'msg error';
                return false;
            }

            if (!data[user]) {
                msg.textContent = '❌ Username belum terdaftar!';
                msg.className = 'msg error';
                return false;
            }

            if (data[user] !== pass) {
                msg.textContent = '❌ Password salah!';
                msg.className = 'msg error';
                return false;
            }

            document.getElementById('authPage').style.display = 'none';
            document.getElementById('mainPage').style.display = 'block';
            document.getElementById('namaPengguna').textContent = user;
            return false;
        }

        function logout() {
            document.getElementById('authPage').style.display = 'flex';
            document.getElementById('mainPage').style.display = 'none';
            document.getElementById('loginUser').value = '';
            document.getElementById('loginPass').value = '';
            clearAllMsg();
        }

        function bukaHalaman(id, btn) {
            document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
            document.querySelectorAll('.nav-link').forEach(n => n.classList.remove('active'));
            document.getElementById(id).classList.add('active');
            btn.classList.add('active');
        }

        function clearAllMsg() {
            document.querySelectorAll('.msg').forEach(m => {
                m.textContent = '';
                m.className = 'msg';
            });
        }
    </script>
</body>
</html>
